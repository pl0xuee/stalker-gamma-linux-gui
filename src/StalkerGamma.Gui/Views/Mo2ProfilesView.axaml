<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StalkerGamma.Gui.ViewModels"
             x:Class="StalkerGamma.Gui.Views.Mo2ProfilesView"
             x:DataType="vm:Mo2ProfilesViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Classes="eyebrow" Text="MOD ORGANIZER"/>
            <TextBlock Classes="h1" Text="MO2 Profiles"/>
            <TextBlock Classes="muted" Text="{Binding CurrentProfileText}" Margin="0,6,0,0"/>
            <TextBlock Classes="muted" Text="{Binding StatusText}" TextWrapping="Wrap"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,12,0,0">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,6"/>
            <Button Content="Set as selected" Command="{Binding SetSelectedCommand}" Margin="0,0,8,6"/>
            <Button Content="Delete" Command="{Binding DeleteSelectedCommand}" Margin="0,0,8,6"/>
        </WrapPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBox Grid.Column="0" Text="{Binding NewProfileName}"
                     PlaceholderText="New profile name (copies the selected profile)"/>
            <Button Grid.Column="1" Content="Duplicate" Margin="8,0,0,0"
                    Command="{Binding DuplicateCommand}"/>
        </Grid>

        <ListBox Grid.Row="3" ItemsSource="{Binding Profiles}"
                 SelectedItem="{Binding SelectedProfile}"/>
    </Grid>
</UserControl>
