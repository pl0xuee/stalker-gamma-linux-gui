<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StalkerGamma.Gui.ViewModels"
             x:Class="StalkerGamma.Gui.Views.UpdatesView"
             x:DataType="vm:UpdatesViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Classes="eyebrow" Text="MAINTENANCE"/>
            <TextBlock Classes="h1" Text="Updates"/>
            <TextBlock Classes="muted" Text="{Binding SummaryText}" Margin="0,6,0,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,12">
            <Button Content="Check for updates" Classes="accent" Command="{Binding CheckCommand}"
                    IsEnabled="{Binding !Runner.IsBusy}" Margin="0,0,8,6"/>
            <Button Content="Apply updates" Command="{Binding ApplyCommand}"
                    IsEnabled="{Binding !Runner.IsBusy}" Margin="0,0,8,6"/>
            <CheckBox Content="Minimal" IsChecked="{Binding Minimal}" Margin="0,0,8,6"/>
            <CheckBox Content="Preserve user.ltx" IsChecked="{Binding PreserveUserSettings}" Margin="0,0,8,6"/>
            <CheckBox Content="Preserve MCM" IsChecked="{Binding PreserveMcmSettings}" Margin="0,0,8,6"/>
        </WrapPanel>

        <Border Grid.Row="2" Classes="card" Margin="0,0,0,12" Padding="14,10"
                IsVisible="{Binding HasResume}" BorderBrush="{StaticResource ZoneAmber}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Unfinished update found" FontWeight="SemiBold"
                               Foreground="{StaticResource ZoneAmber}"/>
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding ResumeText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                    <Button Content="Resume" Classes="accent" Command="{Binding ResumeUpdateCommand}"
                            IsEnabled="{Binding !Runner.IsBusy}"/>
                    <Button Content="Discard" Command="{Binding DiscardResumeCommand}"
                            IsEnabled="{Binding !Runner.IsBusy}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <DataGrid ItemsSource="{Binding Updates}" IsReadOnly="True"
                      AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="ADDON" Binding="{Binding AddonName}" Width="*" MinWidth="160"/>
                    <DataGridTextColumn Header="INSTALLED" Binding="{Binding OldVersion}" Width="170"/>
                    <DataGridTextColumn Header="AVAILABLE" Binding="{Binding NewVersion}" Width="170"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False" TextAlignment="Center" IsVisible="{Binding !Updates.Count}"
                       Text="Outdated, new and removed mods are listed here after a check."/>
        </Grid>
    </Grid>
</UserControl>
