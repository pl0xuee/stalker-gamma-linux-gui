<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StalkerGamma.Gui.ViewModels"
             x:Class="StalkerGamma.Gui.Views.ModsView"
             x:DataType="vm:ModsViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Classes="eyebrow" Text="LOADOUT"/>
            <TextBlock Classes="h1" Text="Mods"/>
            <TextBlock Classes="muted" Text="{Binding ProfileName, StringFormat='MO2 profile: {0}'}" Margin="0,6,0,0"/>
            <TextBlock Classes="muted" Text="{Binding StatusText}" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,12,0,8">
            <TextBox Grid.Column="0" Text="{Binding Filter}" PlaceholderText="Filter mods by name…"/>
            <WrapPanel Grid.Column="1" Margin="8,0,0,0">
                <Button Content="Enable shown" Command="{Binding SetShownCommand}" CommandParameter="on" Margin="0,0,8,0"/>
                <Button Content="Disable shown" Command="{Binding SetShownCommand}" CommandParameter="off" Margin="0,0,8,0"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                <Button Content="Delete selected" Command="{Binding DeleteSelectedCommand}"/>
            </WrapPanel>
        </Grid>

        <!-- Ultrawide: GAMMA ships the widescreen fixes installed but switched off -->
        <Border Grid.Row="2" Classes="card" Padding="14,10" Margin="0,0,0,10">
            <StackPanel Spacing="6">
                <WrapPanel>
                    <TextBlock Classes="eyebrow" Text="ULTRAWIDE" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Text="Aspect ratio:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding AspectRatios}"
                              SelectedItem="{Binding SelectedAspectRatio}"
                              MinWidth="100" Margin="0,0,8,0"/>
                    <Button Content="Fix stretched UI" Classes="accent"
                            Command="{Binding FixUltrawideCommand}"/>
                </WrapPanel>
                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                           Text="Switches on the widescreen fixes GAMMA already installs but ships disabled: Dynamic Aspect Ratio Tweaks (HUD, 3D PDA, minimap, map markers) plus the matching 2D scope reticle patch. Tune it in-game under MCM → DART; undo it by unticking those rows below."/>
                <TextBlock Text="{Binding UltrawideStatusText}" Classes="mono muted" TextWrapping="Wrap"
                           IsVisible="{Binding UltrawideStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="3" ItemsSource="{Binding VisibleMods}"
                  SelectedItem="{Binding SelectedMod}"
                  AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="ENABLED" Width="105">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ModRow">
                            <CheckBox IsChecked="{Binding Enabled}" IsEnabled="{Binding IsToggleable}"
                                      HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
