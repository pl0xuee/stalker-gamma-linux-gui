<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StalkerGamma.Gui.ViewModels"
             x:Class="StalkerGamma.Gui.Views.InstallView"
             x:DataType="vm:InstallViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,14">
            <TextBlock Classes="eyebrow" Text="DEPLOYMENT"/>
            <TextBlock Classes="h1" Text="Install"/>
        </StackPanel>

        <!-- No profile yet: one-click makes one, but say so rather than showing bare placeholders -->
        <Border Grid.Row="1" Classes="card" Margin="0,0,0,14" Padding="14,10"
                IsVisible="{Binding !HasActiveProfile}"
                BorderBrush="{StaticResource ZoneAmber}">
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="No active profile yet. One-click install creates one at ~/Games/GAMMA, or set your own directories on the Settings page first."/>
        </Border>

        <!-- A failed install leaves resume.txt behind -->
        <Border Grid.Row="2" Classes="card" Margin="0,0,0,14" Padding="14,10"
                IsVisible="{Binding HasResume}" BorderBrush="{StaticResource ZoneAmber}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Unfinished install found" FontWeight="SemiBold"
                               Foreground="{StaticResource ZoneAmber}"/>
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding ResumeText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                    <Button Content="Resume" Classes="accent" Command="{Binding ResumeInstallCommand}"
                            IsEnabled="{Binding !Runner.IsBusy}"/>
                    <Button Content="Discard" Command="{Binding DiscardResumeCommand}"
                            IsEnabled="{Binding !Runner.IsBusy}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Hero: one-click -->
        <Border Grid.Row="3" Classes="card-hero" Margin="0,0,0,14">
            <Grid ColumnDefinitions="Auto,*">
                <Rectangle Grid.Column="0" Width="4" Fill="{StaticResource ZoneAmber}"
                           RadiusX="2" RadiusY="2" Margin="0,2,16,2"/>
                <StackPanel Grid.Column="1" Spacing="10">
                    <WrapPanel>
                        <Button Content="⚡ One-click install" Classes="accent" FontSize="15"
                                Padding="20,10" Command="{Binding OneClickInstallCommand}"
                                IsEnabled="{Binding !Runner.IsBusy}" Margin="0,0,14,0"/>
                        <CheckBox Content="Set up Steam afterwards (Steam restarts)"
                                  IsChecked="{Binding SetupSteamAfter}" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Everything in one run: creates a default profile if you have none (~/Games/GAMMA), downloads and installs Anomaly plus all GAMMA mods (~40 GB), adds the Steam shortcut with your newest Proton, creates the prefix and installs prerequisites. When it finishes, press Play in Steam."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Target paths + options -->
        <Border Grid.Row="4" Classes="card" Margin="0,0,0,14">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="eyebrow" Text="TARGET" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Open GAMMA folder" Padding="10,4" FontSize="11"
                            Command="{Binding OpenGammaFolderCommand}"/>
                </Grid>
                <StackPanel Spacing="2">
                    <TextBlock Classes="mono muted" Text="{Binding AnomalyPath, StringFormat='Anomaly  {0}'}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Classes="mono muted" Text="{Binding GammaPath,   StringFormat='GAMMA    {0}'}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Classes="mono muted" Text="{Binding CachePath,   StringFormat='Cache    {0}'}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Classes="muted" FontSize="11"
                           Text="Paths come from the active profile — change them on the Settings page."/>
                <WrapPanel>
                    <CheckBox Content="Minimal (delete cache after extract)" IsChecked="{Binding Minimal}" Margin="0,0,18,0"/>
                    <CheckBox Content="Offline (from cache)" IsChecked="{Binding Offline}" Margin="0,0,18,0"/>
                    <CheckBox Content="Skip GitHub downloads" IsChecked="{Binding SkipGithubDownloads}" Margin="0,0,18,0"/>
                    <CheckBox Content="Skip extract on hash match" IsChecked="{Binding SkipExtractOnHashMatch}" Margin="0,0,18,0"/>
                    <CheckBox Content="Preserve user.ltx" IsChecked="{Binding PreserveUserSettings}" Margin="0,0,18,0"/>
                    <CheckBox Content="Preserve MCM settings" IsChecked="{Binding PreserveMcmSettings}" Margin="0,0,18,0"/>
                    <CheckBox Content="Anomaly mirror (experimental, faster)" IsChecked="{Binding UseAnomalyMirror}"
                              ToolTip.Tip="Download a repacked Anomaly archive from files.faith-beam.com first, falling back to ModDB if it fails."/>
                </WrapPanel>
                <StackPanel Spacing="6" IsVisible="{Binding Offline}">
                    <TextBlock Classes="muted" FontSize="11"
                               Text="Offline install needs local copies of both list files:"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding ModPackMakerPath}"
                                 PlaceholderText="Path to modpack_maker_list.txt"/>
                        <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0"
                                Command="{Binding BrowseOfflineListCommand}" CommandParameter="ModPackMaker"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding ModListPath}"
                                 PlaceholderText="Path to modlist.txt"/>
                        <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0"
                                Command="{Binding BrowseOfflineListCommand}" CommandParameter="ModList"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="5" Spacing="6" Margin="0,0,0,14">
            <WrapPanel>
                <Button Content="Full install" Command="{Binding FullInstallCommand}"
                        IsEnabled="{Binding !Runner.IsBusy}" Margin="0,0,8,6"/>
                <Button Content="Anomaly only" Command="{Binding AnomalyInstallCommand}"
                        IsEnabled="{Binding !Runner.IsBusy}" Margin="0,0,8,6"/>
                <Button Content="Verify Anomaly" Command="{Binding CheckAnomalyCommand}"
                        IsEnabled="{Binding !Runner.IsBusy}" Margin="0,0,8,6"/>
                <Button Content="Purge shader cache" Command="{Binding PurgeShaderCacheCommand}"
                        IsEnabled="{Binding !Runner.IsBusy}" Margin="0,0,8,6"/>
                <Button Content="Delete ReShade" Command="{Binding DeleteReshadeCommand}"
                        IsEnabled="{Binding !Runner.IsBusy}" Margin="0,0,8,6"/>
            </WrapPanel>
            <TextBlock Text="{Binding CheckResultText}" Classes="mono muted" TextWrapping="Wrap"
                       IsVisible="{Binding CheckResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>

        <Grid Grid.Row="6">
            <DataGrid ItemsSource="{Binding ModRows}" IsReadOnly="True" MinHeight="100"
                      AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="MOD" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="PHASE" Binding="{Binding Phase}" Width="100"/>
                    <DataGridTemplateColumn Header="PROGRESS" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:ModProgressRow">
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}"
                                             IsIndeterminate="{Binding IsIndeterminate}"
                                             Height="10" Margin="4,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="DONE" Binding="{Binding Detail}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="0,24,0,0" IsHitTestVisible="False" TextAlignment="Center"
                       IsVisible="{Binding !ModRows.Count}"
                       Text="Per-mod progress shows up here once an install starts."/>
        </Grid>
    </Grid>
</UserControl>
