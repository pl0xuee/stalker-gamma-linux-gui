<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StalkerGamma.Gui.ViewModels"
             x:Class="StalkerGamma.Gui.Views.SteamSetupView"
             x:DataType="vm:SteamSetupViewModel">
    <ScrollViewer>
        <StackPanel Spacing="14">
            <StackPanel Spacing="2">
                <TextBlock Classes="eyebrow" Text="LAUNCH INTEGRATION"/>
                <TextBlock Classes="h1" Text="Steam"/>
                <TextBlock Classes="muted" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Adds a Steam shortcut for Mod Organizer 2, sets Proton, creates the prefix and installs prerequisites via protontricks."/>
            </StackPanel>

            <!-- Requirements -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="eyebrow" Text="REQUIREMENTS" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Check again" Padding="10,4" FontSize="11"
                                Command="{Binding PreflightCommand}" IsEnabled="{Binding !Runner.IsBusy}"/>
                    </Grid>
                    <TextBlock Text="{Binding PreflightText}" TextWrapping="Wrap" Classes="mono muted"/>
                </StackPanel>
            </Border>

            <!-- Setup -->
            <Border Classes="card-hero">
                <Grid ColumnDefinitions="Auto,*">
                    <Rectangle Grid.Column="0" Width="4" Fill="{StaticResource ZoneAmber}"
                               RadiusX="2" RadiusY="2" Margin="0,2,16,2"/>
                    <StackPanel Grid.Column="1" Spacing="10">
                        <WrapPanel>
                            <StackPanel Spacing="4" Margin="0,0,14,8">
                                <TextBlock Classes="muted" FontSize="11" Text="Shortcut name"/>
                                <TextBox Text="{Binding AppName}" Width="220"/>
                            </StackPanel>
                            <StackPanel Spacing="4" Margin="0,0,14,8">
                                <TextBlock Classes="muted" FontSize="11" Text="Proton"/>
                                <ComboBox ItemsSource="{Binding CompatTools}" SelectedItem="{Binding SelectedTool}"
                                          MinWidth="280"/>
                            </StackPanel>
                        </WrapPanel>
                        <WrapPanel>
                            <CheckBox Content="I understand Steam will be closed and restarted"
                                      IsChecked="{Binding ConfirmRestart}" Margin="0,0,14,0"/>
                            <Button Content="Run Steam setup" Classes="accent" Padding="18,8"
                                    Command="{Binding RunSetupCommand}" IsEnabled="{Binding CanRunSetup}"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Progress -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="eyebrow" Text="STEPS"/>
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SetupStep">
                                <Grid ColumnDefinitions="28,*" Margin="0,3">
                                    <TextBlock Grid.Column="0" Text="{Binding Status}" HorizontalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding Name}"/>
                                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" TextWrapping="Wrap"
                                                   IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
